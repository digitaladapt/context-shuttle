# .dockerignore — the canonical leaf (Guiding Light §6.2).
# /docker and /docs are documentation/build inputs, not image content;
# config/ is NEVER dockerignored (§6.3).

# VCS & CI
.git
.gitignore
.gitattributes
.gitea
.github
.ci
.phpunit.cache
.php-cs-fixer.dist.php
phpstan.neon.dist
rector.php
.editorconfig

# Local env — never bake secrets into images (§8.12)
.env
.env.local
.env.local.php
.env.*.local
.env.dev
.env.test
host.env
config/secrets/prod/prod.decrypt.private.php

# Local runtime state
var
*.sqlite
*.sqlite3
*.db
# Dev artifacts & host-side files not needed at runtime
tests
vendor
node_modules
importmap.php
assets
translations
templates
migrations
docs
compose.yaml
Dockerfile
.dockerignore
.php-version
.phpunit.cache
.php-cs-fixer.cache
.php-cs-fixer.dist.php
phpstan.neon.dist
phpstan-baseline.neon
rector.php
.editorconfig
README.md
CHANGELOG.md
CONTRIBUTING.md
SECURITY.md
AGENTS.md
CLAUDE.md
*.md