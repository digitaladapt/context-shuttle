# ── context-shuttle environment ──────────────────────────────────────
# Copy to .env.local (dev) or inject at runtime (prod). .env is never
# committed (Guiding Light §5.1); only safe defaults live here.

APP_ENV=dev
APP_SECRET=

# ── Routing ──────────────────────────────────────────────────────────
# Base URI for generating URLs in non-HTTP contexts (CLI commands).
# Required by config/packages/routing.yaml.
DEFAULT_URI=http://localhost

# ── MCP identity ─────────────────────────────────────────────────────
# Name and version reported in MCP initialize responses and OpenAPI info.
MCP_SERVER_NAME=context-shuttle
MCP_SERVER_VERSION=1.0.0

# ── Logging ──────────────────────────────────────────────────────────
# Monolog writes JSON to stdout. LOG_LEVEL sets the minimum level for
# all handlers (Monolog level name: debug/info/warning/error).
LOG_LEVEL=info

# ── CORS ─────────────────────────────────────────────────────────────
# Cross-Origin-Resource-Policy sent on every response. Controls whether
# other sites may load these responses as no-cors subresources (images,
# scripts, fonts); it does not affect the CORS handshake itself.
#   same-site     (default) same-site pages only
#   same-origin   this exact origin only
#   cross-origin  any site (opt out of embedding protection)
# Unset or empty means same-site; any other value fails loudly at boot.
CORS_RESOURCE_POLICY=same-site

# ── Penny-track (get_transactions tool) ──────────────────────────────
# Base URL of your self-hosted penny-track instance and a read-only
# API key (create with bin/console app:create-api-key in penny-track).
# Leave both empty to disable the tool; it errors clearly when invoked.
PENNYTRACK_URL=
PENNYTRACK_API_KEY=

# ── Vital-pulse (get_health_logs tool) ─────────────────────────────
# Base URL of your self-hosted vital-pulse instance and an API key
# (from its API_KEY / optional READ_ONLY_API_KEY config). A read-only
# key is sufficient — the tool only reads. Leave both empty to disable
# the tool; it errors clearly when invoked.
VITALPULSE_URL=
VITALPULSE_API_KEY=

# ── Calendar (calendar_list_events tool) ─────────────────────────────
# Base URL of your CalDAV server and the credentials to read it with.
# Basic auth only; most servers want an app password rather than an
# account password. CALDAV_PASSWORD may also live in the secrets vault
# (bin/console secrets:set CALDAV_PASSWORD). Leave CALDAV_URL empty to
# disable the tool; it errors clearly when invoked.
#
# Google's CalDAV endpoint does not accept Basic auth, so Google Calendar
# is not supported until an OAuth path exists.
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=

# Optional comma-separated hrefs to expose, e.g. /calendars/me/work/.
# Empty means every calendar the account can see. Useful when a server
# also exposes subscribed holidays or shared team calendars.
CALDAV_CALENDARS=

# ── Timezone (calendar tools) ────────────────────────────────────────
# The deployment's timezone: every calendar timestamp is rendered in it,
# and calendar date inputs are read in it, so callers never handle
# offsets or daylight-saving changes themselves. Use an IANA identifier.
# An invalid value fails loudly at boot rather than defaulting to UTC.
TZ=UTC

# ── Alerts (send_alert tool) ───────────────────────────────────────
# One-way notifications. Channels are enabled by presence — set a
# topic and/or a webhook URL; with both set, both receive every
# alert. With neither set, the tool errors clearly when invoked.
#
# ntfy: NTFY_TOPIC is required to enable the channel. NTFY_URL
# defaults to https://ntfy.sh (set it for a self-hosted server);
# NTFY_TOKEN is optional for access-controlled servers.
# Pick a topic name that is hard to guess — on public servers the
# topic is effectively a shared secret, like a password.
NTFY_TOPIC=
NTFY_URL=
NTFY_TOKEN=
#
# Discord: DISCORD_WEBHOOK_URL is required to enable the channel
# (Channel settings → Integrations → Webhooks → Copy Webhook URL).
# DISCORD_MENTION_USER_ID is optional; only priority-5 alerts may
# mention it, and @everyone/@here can never be mentioned.
DISCORD_WEBHOOK_URL=
DISCORD_MENTION_USER_ID=

# ── Email (list_emails / read_email tools) ──────────────────────────────────
# Read access to a mail server over IMAP. With IMAP_HOST, IMAP_USERNAME or
# IMAP_PASSWORD unset the tools stay listed but error clearly when invoked.
#
# If you see nothing in your inbox, that is almost always a permissions
# problem rather than an empty mailbox: check that IMAP_READ_FOLDERS below
# lists the folder, then restart the container so the change takes effect.
#
# Google/Gmail: enable 2FA and use an app password (a regular password is
# rejected). This uses IMAP with a plain login, which is what Dovecot,
# Nextcloud, Fastmail, Proton Bridge and Apple app passwords all accept.
IMAP_HOST=
IMAP_USERNAME=
IMAP_PASSWORD=
# 993 (default) for implicit TLS, 143 for STARTTLS. Which one is right
# depends on whether your provider uses port 993 with SSL/TLS or 143 with
# STARTTLS; set both to match.
IMAP_PORT=
# ssl (default), starttls or tcp. ssl uses implicit TLS on connect (port
# 993); starttls negotiates TLS after connecting (port 143). Leave empty
# for ssl unless your provider needs otherwise.
IMAP_ENCRYPTION=

# ── Email folder permissions ────────────────────────────────────────────────
# THE IMPORTANT SETTING. Every folder-based operation is gated by its own
# allowlist, so reading a folder does not grant tagging it, marking it read,
# or moving from it. These lists are comma-separated folder names; empty
# means the operation is disabled (a fresh deployment can read, and change
# nothing). An operation on a folder not named in its list is REFUSED with
# an error naming the list to set — never silently ignored.
#
# Every list uses the folder's display name, e.g. INBOX, Archive, or
# Projects/Widget. INBOX is matched case-insensitively (IMAP requires it);
# other names are case-sensitive, so Archive and archive are different.
#
# Read: list_emails and read_email may name only these folders.
IMAP_READ_FOLDERS=
# Tagging: tag_email may add/remove labels on messages in these folders.
# Tags are IMAP keywords — the agent's own bookkeeping, invisible in most
# mail clients, and the recommended way to track "handled" without touching
# the unread count. Safe to enable widely.
IMAP_TAG_FOLDERS=
# Marking: mark_email_read / mark_email_unread may change state of messages
# in these folders. Unlike tagging, this changes “Seen” — the shared signal
# every other mail client shows — so leave it empty if the human relies on
# unread counts, and prefer IMAP_TAG_FOLDERS for the agent's own state.
IMAP_MARK_FOLDERS=
# Moving: separate source and target lists, so a deployment can allow
# "file things out of INBOX" without allowing "pull anything out of
# Archive". The source list gates move_email entirely; the target list
# gates only destination "folder" (the named trash/archive destinations
# answer to their own variables below). folder listings
# (list_email_folders) report both, and report which named destinations
# exist.
IMAP_MOVE_SOURCE_FOLDERS=
IMAP_MOVE_TARGET_FOLDERS=

# ── Email destinations named by move_email ──────────────────────────────────
# move_email takes destination trash/archive/folder. These name which
# folder "trash" and "archive" mean; with one unset, that destination is
# refused. Nothing here deletes: IMAP's only delete is a mailbox-wide
# expunge that would also destroy messages other clients flagged, so the
# tool surface moves messages into a folder where a human can recover them.
IMAP_TRASH_FOLDER=
IMAP_ARCHIVE_FOLDER=
# Alias for IMAP_TRASH_FOLDER, spelled the word an operator looks for when
# asking "where do deleted emails go". If both are set, IMAP_DELETE_FOLDER
# wins. Nothing in this deployment expires deleted messages — a message in
# the trash folder sits there until a human (or another mail client) says
# otherwise.
IMAP_DELETE_FOLDER=
